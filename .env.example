# Keep the existing BFF base URL. It resolves house and tenant from the app key.
REACT_APP_BFF_URL=https://api.tropadostelecos.com.br/
# Supply ONLY the pagabandida app key through the existing hosting/local environment.
REACT_APP_APP_KEY=
# Optional: newly provisioned Paga Bandida properties. Blank disables collection.
